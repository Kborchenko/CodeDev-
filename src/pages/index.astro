.page[data-slug="home"] .sec { padding:76px 0; }
.page[data-slug="home"] .sec-head { margin-bottom:32px; }
.page[data-slug="home"] h2 { text-transform:none; letter-spacing:-.03em; }
.page[data-slug="home"] .foot { border-top:1px solid var(--border); }
