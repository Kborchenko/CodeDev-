.card,.vac,.form,.terms,.cta-band,.stats { border-radius:14px; }
.card:hover,.vac:hover { border-color:var(--border-hi); background:#15231A; }
.stat { background:var(--bg-2); }
.foot h4 { font-family:var(--body); letter-spacing:.02em; text-transform:none; font-weight:700; }
.foot-bot { font-family:var(--body); font-size:13px; }
.crumbs { font-family:var(--body); }
.page .logo-mark { filter:none; }
.page .logo span { color:var(--accent); }
.page .nav .logo span { color:var(--accent); }
.page .logo { letter-spacing:-.02em; }
.form input,.form select,.form textarea { background:#0D1711; border-color:var(--border-hi); }
.chip { background:#0D1711; border-color:var(--border); }
.chip-on { background:rgba(58,149,97,.16); }
.rung { background:var(--surface); }
