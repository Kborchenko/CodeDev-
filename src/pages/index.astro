    }
  });
  document.addEventListener('focusin', function(event){
    const block = event.target.closest('.reveal-pending');
    if (block) block.classList.remove('reveal-pending');
  });

  function show(slug, role){
    let target = null;
    pages.forEach(function(p){ if (p.dataset.slug === slug) target = p; });
    if (!target){ location.hash = '#/home'; return; }
    pages.forEach(function(p){ p.hidden = (p !== target); });
    document.title = titles[slug] || 'CodeDev';
    target.querySelectorAll('.nav-links a:not(.btn)').forEach(function(link){ const active = link.getAttribute('href') === '#/' + slug; link.classList.toggle('active',active); if(active) link.setAttribute('aria-current','page'); else link.removeAttribute('aria-current'); });
    const menu = target.querySelector('#menu'), burger = target.querySelector('#burger');
    if (burger && menu && !burger.dataset.bound){
