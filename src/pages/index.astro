  particle.style.animationDelay = `${-(i%14)}s`;
  atmosphere.append(particle);
 }
 scene.classList.add('robot-preview');
 scene.prepend(atmosphere);
 const atmosphereObserver = new IntersectionObserver((entries) => {
  const visible = entries[0].isIntersecting;
