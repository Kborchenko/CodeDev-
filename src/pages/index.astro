 const maximum = () => Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
 function tick(time) {
  if (Math.abs(window.scrollY-lastWritten)>3) { stop(); return; }
  target = Math.max(0,Math.min(maximum(),target));
  const dt = Math.min(40,time-previousTime || 16.7);
  previousTime = time;
  const next = window.scrollY + (target-window.scrollY)*(1-Math.exp(-dt/105));
  window.scrollTo({top:Math.abs(target-next)<.75?target:next,behavior:'instant'});
  lastWritten = window.scrollY;
  if (Math.abs(target-window.scrollY)>.75) frame = requestAnimationFrame(tick);
  else frame = 0;
 }
 window.addEventListener('wheel',(event) => {
  if (reduced.matches || !desktop.matches || event.ctrlKey || event.metaKey || event.shiftKey || event.defaultPrevented || Math.abs(event.deltaX)>Math.abs(event.deltaY)) return;
