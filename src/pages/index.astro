<script>

(function(){
  const pages = document.querySelectorAll('.page');
  const roles = {backend:'Backend-разработчик (junior)',frontend:'Frontend-разработчик (junior)',analyst:'Тестировщик / аналитик веб-приложений',partner:'Менеджер по работе с партнёрами',support:'Оператор чат-поддержки / чат-менеджер',trainee:'Обучение программированию с нуля'};
  const titles = {'prices':'Цены на услуги · CodeDev','home':'CodeDev — IT-компания','team':'Собираем команду · CodeDev','vacancy-analyst':'Тестировщик / аналитик · CodeDev','vacancy-partner':'Менеджер по работе с партнёрами · CodeDev','vacancy-support':'Оператор чат-поддержки · CodeDev','vacancy-backend':'Backend (junior) · CodeDev','vacancy-frontend':'Frontend (junior) · CodeDev','vacancy-trainee':'Обучение программированию · CodeDev','about':'О компании · CodeDev','apply':'Запрос на проект · CodeDev','career-apply':'Отклик в CodeDev'};

  function makeMailto(subject, rows){
    const body = rows.map(([label, value]) => `${label}: ${value || '—'}`).join('\n');
    return `mailto:CodeDeveloper@mail.ru?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }
  function openPreparedMail(form, done, link, mailto){
    link.href = mailto;
    form.hidden = true;
    done.classList.add('on');
    window.location.assign(mailto);
    window.scrollTo({top:0, behavior:'smooth'});
  }

  function bindForm(scope){
    const form = scope.querySelector('#applyForm');
    if(!form || form.dataset.bound) return;
    form.dataset.bound = 1;
    const check = (id, ok) => { const w = scope.querySelector('#'+id); w.classList.toggle('invalid', !ok); return ok; };
    form.addEventListener('submit', async e => {
      e.preventDefault();
      const g = id => scope.querySelector('#'+id).value.trim();
      const okN = check('f-name', g('name').length>=2);
      const okC = check('f-contact', g('contact').length>=3);
      const okR = check('f-role', g('role')!=='');
      const okAgreement = scope.querySelector('#agreement').checked;
      scope.querySelector('#f-consent').classList.toggle('invalid', !okAgreement);
      if(!okN||!okC||!okR||!okAgreement){ const bad = scope.querySelector('.invalid input, .invalid select'); if(bad) bad.focus(); return; }
      const v = id => scope.querySelector('#'+id).value.trim();
      const mailto = makeMailto('Отклик на вакансию · CodeDev', [
        ['Имя',v('name')],['Контакт',v('contact')],['Направление',v('role')],
        ['Опыт',v('exp')],['Город',v('city')],['О себе',v('about')],['Пользовательское соглашение','Принято']
      ]);
      openPreparedMail(form, scope.querySelector('#done'), scope.querySelector('#career-mail-link'), mailto);
    });
    const agreement = scope.querySelector('#agreement');
    if(agreement) agreement.addEventListener('change', function(){ scope.querySelector('#f-consent').classList.remove('invalid'); });
    ['name','contact','role'].forEach(function(id){
      const el = scope.querySelector('#'+id);
      if(el){ el.addEventListener('input', function(){ el.closest('.field').classList.remove('invalid'); });
              el.addEventListener('change', function(){ el.closest('.field').classList.remove('invalid'); }); }
    });
  }

  function bindProjectForm(scope){
    const form = scope.querySelector('#projectForm');
    if(!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    const value = id => scope.querySelector('#'+id).value.trim();
    const mark = (id, valid) => { const field = scope.querySelector('#'+id); field.classList.toggle('invalid', !valid); return valid; };
    const agreement = scope.querySelector('#project-agreement');
    const consent = scope.querySelector('#p-consent');
    const consentError = scope.querySelector('.project-consent-error');
    form.addEventListener('submit', event => {
      event.preventDefault();
      const validCompany = mark('p-company', value('company').length >= 2);
      const validPerson = mark('p-person', value('person').length >= 2);
      const validContact = mark('p-contact', value('project-contact').length >= 4);
      const validService = mark('p-service', value('service') !== '');
      const validDescription = mark('p-description', value('project-description').length >= 12);
      const validAgreement = agreement.checked;
      consent.classList.toggle('invalid', !validAgreement);
      consentError.hidden = validAgreement;
      const email = scope.querySelector('#project-email');
      const website = scope.querySelector('#current-site');
      const validOptional = email.checkValidity() && website.checkValidity();
      if(!validCompany || !validPerson || !validContact || !validService || !validDescription || !validAgreement || !validOptional){
        const first = scope.querySelector('.invalid input, .invalid select, .invalid textarea') || (validOptional ? null : (!email.checkValidity() ? email : website));
        first?.focus();
        return;
      }
      const mailto = makeMailto('Запрос на проект · CodeDev', [
        ['Компания',value('company')],['Контактное лицо',value('person')],['Telegram или телефон',value('project-contact')],
        ['Рабочая почта',value('project-email')],['Направление',value('service')],['Описание задачи',value('project-description')],
        ['Бюджет',value('budget')],['Желаемый срок',value('timeline')],['Сайт компании',value('current-site')],['Пользовательское соглашение','Принято']
      ]);
      openPreparedMail(form, scope.querySelector('#project-done'), scope.querySelector('#project-mail-link'), mailto);
    });
    agreement.addEventListener('change', () => { consent.classList.remove('invalid'); consentError.hidden = true; });
    [['company','p-company'],['person','p-person'],['project-contact','p-contact'],['service','p-service'],['project-description','p-description']].forEach(([id,fieldId]) => {
      const field = scope.querySelector('#'+id);
      field.addEventListener('input', () => scope.querySelector('#'+fieldId).classList.remove('invalid'));
      field.addEventListener('change', () => scope.querySelector('#'+fieldId).classList.remove('invalid'));
    });
  }

  let revealObserver = null;
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  function revealOnScroll(target) {
    if (revealObserver) revealObserver.disconnect();
    document.querySelectorAll('.reveal-pending').forEach(function(el){ el.classList.remove('reveal-pending'); });
    const candidates = Array.from(target.querySelectorAll('.rise, section h2, section h3, section p, section .eyebrow, .work-step'));
    const blocks = candidates.filter(function(el){
      return !el.closest('.hero, .form, form') && !candidates.some(function(parent){ return parent !== el && parent.contains(el); });
    });
    if (motionPreference.matches || !('IntersectionObserver' in window)) return;
    revealObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (!entry.isIntersecting) return;
