@media(max-width:760px){.page[data-slug="home"] .hero-grid>div:first-child{padding:56px 24px 40px}.page[data-slug="home"] .term{min-height:350px}.page[data-slug="home"] .stats{grid-template-columns:repeat(2,1fr)}.page[data-slug="home"] .stat:nth-child(2){border-right:0}.page[data-slug="home"] .stat:nth-child(-n+2){border-bottom:1px solid var(--border)}}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  font-size: 16px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* Фоновая сетка */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 64px 64px;
  opacity: .25;
  pointer-events: none;
  z-index: 0;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 100%);
}

.wrap { width: 100%; max-width: var(--wrap); margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

a { color: inherit; text-decoration: none; }

::selection { background: var(--accent); color: #04150C; }

:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

/* ---------- Шапка ---------- */
.nav {
  position: sticky; top: 0; z-index: 50;
  background: rgba(8, 11, 10, .82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
}
.nav-in { display: flex; align-items: center; justify-content: space-between; height: 68px; }

.logo { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 700; font-size: 19px; letter-spacing: -.02em; }
.logo-mark {
  width: 36px; height: 36px;
  object-fit: contain;
  display: block;
  filter: none;
}
.logo span { color: var(--accent); }

.nav-links { display: flex; align-items: center; gap: 28px; }
.nav-links a { font-size: 14.5px; color: var(--muted); transition: color .18s; }
.nav-links a:hover, .nav-links a.active { color: var(--text); }
.nav-links a.active { color: var(--accent); }

.burger { display: none; background: none; border: 1px solid var(--border-hi); border-radius: 8px; width: 40px; height: 40px; color: var(--text); cursor: pointer; font-size: 18px; }

/* ---------- Кнопки ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 9px;
  padding: 14px 26px; border-radius: 10px;
  font-family: var(--display); font-weight: 600; font-size: 15px;
  cursor: pointer; border: 1px solid transparent;
  transition: transform .16s, box-shadow .16s, background .16s, border-color .16s;
  white-space: nowrap;
}
.btn-primary { background: var(--accent); color: #04150C; box-shadow: 0 0 0 rgba(0,255,136,0); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0,255,136,.22); }
.btn-ghost { background: transparent; color: var(--text); border-color: var(--border-hi); }
.btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
.btn-sm { padding: 10px 18px; font-size: 14px; }
.btn-full { width: 100%; }

/* ---------- Метки ---------- */
.eyebrow {
  font-family: var(--mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
  color: var(--accent); display: inline-flex; align-items: center; gap: 8px; margin-bottom: 18px;
}
.eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--accent); }

.chip {
  display: inline-block; padding: 5px 12px; border-radius: 999px;
  border: 1px solid var(--border-hi); background: var(--bg-2);
  font-family: var(--mono); font-size: 12px; color: var(--muted);
}
.chip-on { border-color: var(--accent); color: var(--accent); background: var(--accent-gl); }

/* ---------- Секции ---------- */
.sec { padding: 96px 0; position: relative; z-index: 1; }
.sec-tight { padding: 64px 0; }
.sec-head { max-width: 720px; margin-bottom: 52px; }

h1, h2, h3, h4 { font-family: var(--display); letter-spacing: -.03em; line-height: 1.12; font-weight: 700; }
h1 { font-size: clamp(38px, 6vw, 66px); }
h2 { font-size: clamp(28px, 4vw, 42px); }
h3 { font-size: 21px; letter-spacing: -.02em; }
.lead { color: var(--muted); font-size: 17.5px; line-height: 1.7; margin-top: 18px; }

/* ---------- Герой ---------- */
.hero { padding: 92px 0 72px; position: relative; z-index: 1; }
.hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 60px; align-items: center; }
.hero h1 { margin-bottom: 4px; }
.hero h1 em { font-style: normal; color: var(--accent); }
.hero-cta { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }
.hero-note { margin-top: 22px; font-family: var(--mono); font-size: 12.5px; color: var(--muted); }

/* Терминал */
.term {
  background: var(--bg-2); border: 1px solid var(--border-hi); border-radius: var(--r);
  overflow: hidden; box-shadow: 0 30px 70px rgba(0,0,0,.5);
}
.term-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid var(--border); background: var(--surface); }
.dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border-hi); }
.dot.g { background: var(--accent); }
.term-file { margin-left: 10px; font-family: var(--mono); font-size: 12px; color: var(--muted); }
.term-body { padding: 22px 20px; font-family: var(--mono); font-size: 13.5px; line-height: 2; }
.tk-key { color: #6FA8FF; }
.tk-str { color: var(--accent); }
.tk-num { color: #FFD166; }
.tk-com { color: var(--muted); }
.caret { display: inline-block; width: 8px; height: 15px; background: var(--accent); vertical-align: -2px; animation: blink 1.1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* ---------- Карточки ---------- */
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r); padding: 28px;
  transition: border-color .2s, transform .2s;
}
.card:hover { border-color: var(--border-hi); transform: translateY(-3px); }
.card h3 { margin-bottom: 10px; }
.card p { color: var(--muted); font-size: 15px; }
.card-ico {
  width: 40px; height: 40px; border-radius: 10px; background: var(--accent-gl);
  border: 1px solid var(--border-hi); display: grid; place-items: center;
  font-family: var(--mono); font-size: 15px; font-weight: 700; color: var(--accent); margin-bottom: 18px;
}

/* Статистика */
.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
.stat { background: var(--bg-2); padding: 30px 24px; }
.stat-n { font-family: var(--display); font-size: 32px; font-weight: 700; color: var(--accent); letter-spacing: -.03em; }
.stat-l { font-family: var(--mono); font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-top: 6px; }

/* ---------- Карточка вакансии ---------- */
.vac {
  display: grid; grid-template-columns: 1fr auto; gap: 26px; align-items: center;
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r);
  padding: 28px 30px; margin-bottom: 16px;
  transition: border-color .2s, transform .2s, background .2s;
}
.vac:hover { border-color: var(--accent); transform: translateY(-2px); background: var(--bg-2); }
.vac-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
.vac h3 { margin-bottom: 8px; }
.vac p { color: var(--muted); font-size: 15px; }
.vac-pay { font-family: var(--display); font-weight: 700; font-size: 19px; color: var(--accent); margin-top: 12px; letter-spacing: -.02em; }
.vac-pay small { display: block; font-family: var(--mono); font-weight: 400; font-size: 11.5px; color: var(--muted); letter-spacing: .06em; text-transform: uppercase; margin-top: 3px; }
.vac-side { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }

/* ---------- Лестница грейдов (фирменный элемент) ---------- */
.ladder { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
.rung { padding: 32px 28px; background: var(--bg-2); border-right: 1px solid var(--border); position: relative; }
.rung:last-child { border-right: 0; }
.rung-bar { height: 3px; border-radius: 2px; background: var(--border-hi); margin-bottom: 22px; }
.rung:nth-child(1) .rung-bar { background: var(--accent); width: 34%; }
.rung:nth-child(2) .rung-bar { background: var(--accent); width: 68%; opacity: .7; }
.rung:nth-child(3) .rung-bar { background: var(--accent); width: 100%; opacity: .45; }
.rung-t { font-family: var(--mono); font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
.rung h3 { font-size: 24px; margin-bottom: 6px; }
.rung .pay { font-family: var(--display); font-weight: 600; color: var(--accent); font-size: 16px; }
.rung p { color: var(--muted); font-size: 14.5px; margin-top: 12px; }

/* ---------- Списки ---------- */
.ticks { list-style: none; display: grid; gap: 13px; }
.ticks li { position: relative; padding-left: 28px; color: var(--muted); font-size: 15.5px; }
.ticks li::before {
  content: ''; position: absolute; left: 0; top: 9px;
  width: 7px; height: 7px; border-radius: 2px; background: var(--accent);
  box-shadow: 0 0 10px var(--accent-gl);
}
.ticks li strong { color: var(--text); font-weight: 600; }

/* Таблица условий */
.terms { border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
.term-row { display: grid; grid-template-columns: 200px 1fr; gap: 20px; padding: 20px 26px; border-bottom: 1px solid var(--border); background: var(--surface); }
.term-row:last-child { border-bottom: 0; }
.term-row dt { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); padding-top: 3px; }
.term-row dd { color: var(--text); font-size: 15.5px; }

/* ---------- Форма ---------- */
.form { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r); padding: 34px; }
.field { margin-bottom: 20px; }
.field label { display: block; font-family: var(--mono); font-size: 12px; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); margin-bottom: 9px; }
.field label .req { color: var(--accent); }
.field input, .field select, .field textarea {
  width: 100%; padding: 14px 16px;
  background: var(--bg); border: 1px solid var(--border-hi); border-radius: 10px;
  color: var(--text); font-family: var(--body); font-size: 15px;
  transition: border-color .18s, box-shadow .18s;
}
.field input::placeholder, .field textarea::placeholder { color: #566159; }
.field input:focus, .field select:focus, .field textarea:focus {
  outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-gl);
}
.field textarea { resize: vertical; min-height: 96px; }
.field select { appearance: none; background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%237C8B84' stroke-width='2'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 14px center; background-size: 18px; padding-right: 42px; }
.form-hint { font-size: 13.5px; color: var(--muted); margin-top: 16px; text-align: center; line-height: 1.6; }
.form-hint a { color: var(--accent); }
.consent { display: flex; align-items: flex-start; gap: 11px; margin: 8px 0 20px; color: var(--muted); font-size: 14px; line-height: 1.55; cursor: pointer; }
.consent input { flex: 0 0 18px; width: 18px; height: 18px; margin-top: 2px; accent-color: var(--accent); cursor: pointer; }
.consent a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
.consent.invalid { color: #FF6B6B; }
.err { color: #FF6B6B; font-size: 13px; margin-top: 7px; display: none; }
.field.invalid input, .field.invalid select { border-color: #FF6B6B; }
.field.invalid .err { display: block; }

.done { display: none; text-align: center; padding: 20px 0; }
.done.on { display: block; }
.done-ico { width: 56px; height: 56px; border-radius: 50%; background: var(--accent-gl); border: 1px solid var(--accent); display: grid; place-items: center; margin: 0 auto 18px; font-size: 24px; color: var(--accent); }

/* ---------- CTA-полоса ---------- */
.cta-band {
  border: 1px solid var(--border-hi); border-radius: var(--r);
  background: linear-gradient(135deg, var(--surface), var(--bg-2));
  padding: 52px; text-align: center; position: relative; overflow: hidden;
}
.cta-band::after {
  content: ''; position: absolute; top: -50%; left: 50%; transform: translateX(-50%);
  width: 480px; height: 480px; border-radius: 50%;
  background: radial-gradient(circle, var(--accent-gl), transparent 68%);
  pointer-events: none;
}
.cta-band > * { position: relative; z-index: 1; }
.cta-band p { color: var(--muted); max-width: 560px; margin: 16px auto 30px; }

/* ---------- Подвал ---------- */
.foot { border-top: 1px solid var(--border); padding: 56px 0 34px; margin-top: 40px; position: relative; z-index: 1; }
.foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; margin-bottom: 40px; }
.foot p { color: var(--muted); font-size: 14.5px; margin-top: 14px; max-width: 320px; }
.foot h4 { font-size: 13px; font-family: var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; font-weight: 500; }
.foot ul { list-style: none; display: grid; gap: 10px; }
.foot ul a { color: var(--text); font-size: 14.5px; opacity: .8; }
.foot ul a:hover { color: var(--accent); opacity: 1; }
.foot-bot { border-top: 1px solid var(--border); padding-top: 26px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-family: var(--mono); font-size: 12.5px; color: var(--muted); }

/* Хлебные крошки */
.crumbs { font-family: var(--mono); font-size: 12.5px; color: var(--muted); padding: 30px 0 0; }
.crumbs a:hover { color: var(--accent); }
.crumbs span { margin: 0 8px; opacity: .5; }

/* Появление */
.rise { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
.rise.in { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  * { animation: none !important; transition: none !important; }
  .rise { opacity: 1; transform: none; }
  html { scroll-behavior: auto; }
}

