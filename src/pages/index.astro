 const dots = [...scene.querySelectorAll('.service-dot')];
 const range = scene.querySelector('.service-range');
 const description = scene.querySelector('.service-description');
 let current = 0;
 function select(index) {
  current = Math.max(0,Math.min(2,index));
  const item = items[current];
  dots.forEach((dot,i) => dot.setAttribute('aria-pressed',String(i === current)));
  scene.querySelector('.service-number').textContent = String(current + 1).padStart(3,'0');
  description.querySelector('.tk-str').textContent = item[0];
  description.querySelector('.service-copy').textContent = item[1];
  range.value = String(current);
  range.setAttribute('aria-valuetext',`${current + 1} из 3: ${item[0]} — ${item[1]}`);
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
   description.animate([{opacity:.35,transform:'translateY(6px)'},{opacity:1,transform:'translateY(0)'}],{duration:220,easing:'ease-out'});
  }
 }
 dots.forEach((dot,i) => dot.addEventListener('click',() => select(i)));
 range.addEventListener('input',() => select(Number(range.value)));
 let start = null;
 scene.addEventListener('pointerdown',(event) => {
  if (event.button !== 0 || event.target.closest('button,input,a,label,.robot-stage')) return;
  start = {x:event.clientX,y:event.clientY,id:event.pointerId};
  scene.setPointerCapture(event.pointerId);
 });
 scene.addEventListener('pointerup',(event) => {
  if (!start || start.id !== event.pointerId) return;
  const dx = event.clientX-start.x, dy = event.clientY-start.y;
  if (Math.abs(dx)>45 && Math.abs(dx)>Math.abs(dy)*1.3) select(current+(dx<0?1:-1));
  start = null;
 });
 scene.addEventListener('pointercancel',() => { start = null; });
})();
</script>


<script is:inline>
// Smooth desktop wheel scrolling; touch and precision trackpads stay native.
