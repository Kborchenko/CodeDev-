/* KodeckDev — общие стили */



:root {
  --bg:        #090A09;
  --bg-2:      #0D0E0D;
  --surface:   #111211;
  --border:    #292B27;
  --border-hi: #494B42;
  --text:      #E8E8E0;
  --muted:     #A0A196;
  --accent:    #D9FF28;
  --accent-dk: #B9D915;
  --accent-gl: rgba(217, 255, 40, 0.12);

  --display: "Revolution Gothic", Arial, sans-serif;
  --body:    "Revolution Gothic", Arial, sans-serif;
  --mono:    Arial, Helvetica, sans-serif;

  --wrap: 1140px;
  --r: 14px;
}

/* Единый спокойный стиль всех разделов */
.page[data-slug="home"] .hero { padding:0; border-bottom:1px solid var(--border); }
.page[data-slug="home"] .hero-grid { max-width:1440px; min-height:520px; grid-template-columns:.95fr 1.05fr; gap:0; padding:0; align-items:stretch; }
.page[data-slug="home"] .hero-grid > div:first-child { padding:76px clamp(28px,6vw,88px) 64px; display:flex; flex-direction:column; justify-content:center; border-right:1px solid var(--border); }
.page[data-slug="home"] .term { position:relative; min-height:520px; border:0; border-radius:0; box-shadow:none; background:#090A09 url('/assets/code-digital-face.webp') 68% center/cover no-repeat; display:flex; flex-direction:column; justify-content:flex-end; isolation:isolate; overflow:hidden; }
.page[data-slug="home"] .term::before { content:""; position:absolute; inset:0; z-index:1; opacity:.18; pointer-events:none; background:linear-gradient(rgba(217,255,40,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(217,255,40,.045) 1px,transparent 1px); background-size:42px 42px; }
.page[data-slug="home"] .term::after { content:none; }
.page[data-slug="home"] .term-bar { position:absolute; inset:0 0 auto; background:transparent; border:0; padding:22px 28px; }
.page[data-slug="home"] .term-bar,.page[data-slug="home"] .term-body { z-index:2; }
.page[data-slug="home"] .term-body { position:relative; }
.page[data-slug="home"] .term-file { margin-left:auto; color:#5DB58A; text-transform:uppercase; }
.page[data-slug="home"] .term-body { align-self:flex-end; width:min(420px,90%); margin:0 28px 30px 0; padding:18px 20px; border:1px solid var(--border-hi); background:rgba(8,15,11,.88); font-size:14px; line-height:1.8; }
.page[data-slug="home"] .term-body .solution-label { display:block; color:#5DB58A; font:700 17px/1.25 var(--display); margin:0 0 10px; }
.page[data-slug="home"] .hero h1 { max-width:620px; font:700 clamp(42px,4.8vw,62px)/1.04 var(--display); letter-spacing:-.045em; text-transform:none; }
.page[data-slug="home"] .hero .lead { font:16px/1.65 var(--body); max-width:540px; color:#C3CEC6; }
.nav { background:rgba(9,15,12,.96); }
.nav-in { height:68px; }
.nav-links a { font-size:14px; }
.nav-links a.active { color:#56A87D; }
.btn { border-radius:9px; text-transform:none; font-family:var(--body); font-size:15px; }
.btn-primary { background:var(--accent-dk); color:#F2F7F3; }
.btn-primary:hover { background:#26784D; box-shadow:0 8px 24px rgba(27,101,66,.25); }
.btn-ghost { border-color:var(--border-hi); }
.eyebrow { letter-spacing:.07em; font-family:var(--body); font-weight:700; }
h1,h2,h3,h4 { letter-spacing:-.025em; }
