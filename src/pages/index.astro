.page[data-slug="home"] .sec-tight { padding:34px 0; border-bottom:1px solid var(--border); }
.page[data-slug="home"] .stats { border:0; border-radius:0; background:transparent; grid-template-columns:repeat(4,1fr); gap:0; }
.page[data-slug="home"] .stat { background:transparent; padding:10px 22px; border-right:1px solid var(--border); }
.page[data-slug="home"] .stat:last-child { border:0; }
