<script is:inline>
(() => {
 const links=document.querySelectorAll('.nav-links a');
 links.forEach(link=>{
  const text=link.textContent.trim();
  const stack=document.createElement('span');stack.className='pill-label-stack';
  const main=document.createElement('span');main.className='pill-label-main';main.textContent=text;
  const hover=document.createElement('span');hover.className='pill-label-hover';hover.textContent=text;hover.setAttribute('aria-hidden','true');
  stack.append(main,hover);link.replaceChildren(stack);
 });
 const observer=new ResizeObserver(entries=>entries.forEach(({target:link})=>{
  const {width:w,height:h}=link.getBoundingClientRect();if(!h||!w)return;
  const r=(w*w/4+h*h)/(2*h),d=Math.ceil(2*r)+2;
  const delta=Math.ceil(r-Math.sqrt(Math.max(0,r*r-w*w/4)))+1;
  link.style.setProperty('--pill-circle',`${d}px`);link.style.setProperty('--pill-bottom',`${-delta}px`);link.style.setProperty('--pill-origin',`${d-delta}px`);
 }));
 links.forEach(link=>observer.observe(link));
 document.querySelectorAll('.burger').forEach(button=>{button.textContent='';button.setAttribute('aria-expanded','false');});
 document.addEventListener('keydown',event=>{if(event.key!=='Escape')return;const page=document.querySelector('.page:not([hidden])');const menu=page?.querySelector('.nav-links.open');if(menu){menu.classList.remove('open');const button=page.querySelector('.burger');button.setAttribute('aria-expanded','false');button.focus();}});
})();
</script>

