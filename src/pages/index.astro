    }
    if (menu) menu.classList.remove('open');
    if (burger) { burger.textContent = ''; burger.setAttribute('aria-expanded','false'); }
    if (slug === 'career-apply' && role){
      const sel = target.querySelector('#role');
      if (sel && roles[role]) sel.value = roles[role];
    }
    bindForm(target);
    bindProjectForm(target);
    window.scrollTo(0, 0);
    revealOnScroll(target);
  }

  function route(){
    const h = (location.hash || '#/home').replace(/^#\//, '');
    const parts = h.split('?');
    let slug = parts[0] || 'home';
    const q = parts[1] || '';
    const params = new URLSearchParams(q);
    const role = params.get('role') || '';
    const section = params.get('section');
    if(slug === 'home' && section === 'prices') slug = 'prices';
    show(slug, role);
    if (slug === 'home' && ['services','prices'].includes(section)) {
      requestAnimationFrame(function(){ const node = document.getElementById(section); if(node) node.scrollIntoView({behavior:motionPreference.matches?'instant':'smooth',block:'start'}); });
    }
  }

  window.addEventListener('hashchange', route);
  route();
})();

</script>

<script is:inline>
// Drag is optional; links keep native click and keyboard navigation.
document.querySelectorAll('.page[data-slug="home"] .hero-cta .btn').forEach((button) => {
 let active = null;
 let suppressClick = false;
 button.setAttribute('draggable', 'false');
 button.addEventListener('pointerdown', (event) => {
  if (event.button !== 0) return;
  suppressClick = false;
  active = { id:event.pointerId, x:event.clientX, y:event.clientY, moved:false };
 });
 button.addEventListener('pointermove', (event) => {
  if (!active || event.pointerId !== active.id) return;
  const dx = event.clientX - active.x;
  const dy = event.clientY - active.y;
  if (!active.moved && Math.hypot(dx, dy) < 8) return;
  active.moved = true;
  button.setPointerCapture(event.pointerId);
  button.classList.add('is-dragging');
  button.style.transform = `translate(${Math.max(-28,Math.min(28,dx))}px,${Math.max(-20,Math.min(20,dy))}px)`;
 });
 const release = () => {
  if (!active) return;
  suppressClick = active.moved;
  if (button.hasPointerCapture(active.id)) button.releasePointerCapture(active.id);
  active = null;
  button.classList.remove('is-dragging');
  button.style.transform = '';
 };
 window.addEventListener('pointerup', release);
 window.addEventListener('pointercancel', release);
 button.addEventListener('click', (event) => {
  if (suppressClick && event.detail !== 0) { event.preventDefault(); event.stopImmediatePropagation(); }
  suppressClick = false;
 }, true);
});
</script>


<script is:inline>
(() => {
 const scene = document.querySelector('.page[data-slug="home"] .term');
 if (!scene) return;
